# --- Business OS deploy guard (repo root) ---
# Never track secrets, databases, build output or nested git backups.
**/.env
**/.env.local
**/.env.production
**/*.pem
**/*.key
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.p12
**/*.pfx
**/.git.vendor-backup/
**/node_modules/
**/.next/
**/dist/
**/build/
**/coverage/
**/.data/
