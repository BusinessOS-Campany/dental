# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dentalclinic?schema=public"

# Auth session secret (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-64-char-random-string"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DentalClinic"

# Default super admin bootstrap (used by seed script only)
SEED_ADMIN_EMAIL="admin@dentalclinic.ye"
SEED_ADMIN_PASSWORD="Admin@12345"

# Optional: default currency for seeding (YER)
SEED_CURRENCY="YER"